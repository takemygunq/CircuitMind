# Только сервер. Никогда не отдавать на клиент.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Демо-режим без сети и ключа: ИИ заменён сценарием (метеостанция на ESP32 с исправлением ошибки через ERC).
# CIRCUITMIND_MOCK_AI=1

# Провайдеры и модели выбираются в приложении (⚙ Модели).
# CIRCUITMIND_DATA_DIR=./data
# CIRCUITMIND_ALLOW_REMOTE_SETTINGS=1
