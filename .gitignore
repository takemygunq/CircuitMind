# ───────── зависимости ─────────
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ───────── сборка и тесты ─────────
/.next/
/out/
/build
/coverage
*.tsbuildinfo
next-env.d.ts

# ───────── секреты и личные данные ─────────
.env
.env.*
!.env.example
*.pem
*.key
secret.key
# настройки провайдеров, зашифрованные ключи, сохранённые проекты
/data/
# личные скриншоты, письма, референсы
/reference/
*proof*

# ───────── инструменты разработки и ИИ-ассистенты ─────────
/.claude/
.claude*
.cursor/
.cursorrules
.windsurf/
.aider*
.copilot*
.codex/
.gemini/
CLAUDE.md
AGENTS.md
GEMINI.md
SPEC.md
.idea/
.vscode/
*.log
npm-debug.log*
yarn-debug.log*
.pnpm-debug.log*
.DS_Store
.vercel

# ───────── документация для разработки: в репозитории только README ─────────
*.md
!README.md
!README.ru.md
/docs/*
!/docs/media/
!/docs/media/**

# ───────── сгенерированные и скачанные данные ─────────
library/generated/*
!library/generated/.gitkeep
# картинки каталога: воссоздаются scripts/import-schematik.mjs
/public/parts/catalogue/
/library/catalogue/schematik.jsonl
